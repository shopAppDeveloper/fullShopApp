[Unit]
Description=My Shop Next.js storefront
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/srv/my-shop/frontend
EnvironmentFile=/srv/my-shop/frontend/.env.local
ExecStart=/usr/bin/npm run start -- --hostname 127.0.0.1 --port 3000
Restart=always

[Install]
WantedBy=multi-user.target
