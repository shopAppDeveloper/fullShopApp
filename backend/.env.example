# ------------------------------------------------------------------
# Django
# ------------------------------------------------------------------
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=False
# Number of reverse proxies in front of Django (1 behind nginx) - required for correct rate limiting.
DJANGO_NUM_PROXIES=1
DJANGO_TIME_ZONE=UTC

# Comma-separated hostnames/IPs.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated browser origins allowed to submit CSRF-protected
# requests. Include your real HTTPS domain in production.
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------
# Database
# ------------------------------------------------------------------
DATABASE_ENGINE=django.db.backends.postgresql
DATABASE_NAME=shop
DATABASE_USER=shop
DATABASE_PASSWORD=replace-with-a-strong-password
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432

# ------------------------------------------------------------------
# Oscar/store
# ------------------------------------------------------------------
OSCAR_DEFAULT_CURRENCY=IRT

# True only when you intentionally want development-only pending
# orders before a payment provider is integrated.
CHECKOUT_ALLOW_PENDING_ORDERS=False

# ------------------------------------------------------------------
# Production security
# ------------------------------------------------------------------
# Development default. Set True/31536000 only in production behind HTTPS.
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_HSTS_SECONDS=0

# SMS (console = print to terminal; later a dotted path to a SmsProvider class)
SMS_PROVIDER=console
SMS_API_KEY=
SMS_SENDER=
SMS_TIMEOUT=5

# Admin notifications (a channel turns on when token + chat ids are set; comma-separated chat ids)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_IDS=
BALE_BOT_TOKEN=
BALE_ADMIN_CHAT_IDS=
NOTIFY_CONSOLE=False
LOW_STOCK_THRESHOLD=5

# Server-to-server key for /api/admin/sms/send/ (empty = disabled)
INTERNAL_API_KEY=
SMS_EVENTS_ENABLED=True

# Zarinpal (amounts are Toman). Sandbox on by default; set ZARINPAL_SANDBOX=False in production.
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=True
# Public origin of the shop, used for the payment callback URL
SITE_URL=http://localhost:3000

# Post shipping price in Toman (0 = free)
POST_SHIPPING_PRICE=0
